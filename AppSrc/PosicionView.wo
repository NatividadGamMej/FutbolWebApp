Use cWebView.pkg
Use cWebPanel.pkg
Use cWebForm.pkg

Object oPosicionView is a cWebView
    Set piWidth to 700
    Set psCaption to "Posiciones"

    Object oMainPanel is a cWebPanel
        Set piColumnCount to 12

        Object oNombre is a cWebForm
            Set piColumnSpan to 6
            Set psLabel to "Posición"
        End_Object

    End_Object

End_Object