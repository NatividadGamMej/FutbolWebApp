Use cWebView.pkg
Use cWebPanel.pkg
Use cWebForm.pkg

Object oEquipoView is a cWebView
    Set piWidth to 700
    Set psCaption to "Equipos"

    Object oMainPanel is a cWebPanel
        Set piColumnCount to 12

        Object oNombre is a cWebForm
            Set piColumnSpan to 6
            Set psLabel to "Nombre del equipo"
        End_Object

    End_Object

End_Object
