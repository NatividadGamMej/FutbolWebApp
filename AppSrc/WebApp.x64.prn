37312>>>    Procedure DoLogin
37315>>>        String sLoginName sPassword sPrevStateHash
37315>>>        Boolean bResult
37315>>>        
37315>>>        WebGet psValue of oLoginName to sLoginName
37316>>>        WebGet psValue of oPassword to sPassword
37317>>>        
37317>>>        Get UserLogin of ghoWebSessionManager sLoginName sPassword to bResult
37318>>>        
37318>>>        If (bResult) Begin
37320>>>            Send Hide of oLogin
37321>>>            Send ShowHeader of ghoWebApp
37322>>>            WebSet psCSSClass of ghoWebApp to ""
37323>>>            
37323>>>            WebGet psPrevStateHash to sPrevStateHash
37324>>>            Send NavigateToStateHash of ghoWebApp sPrevStateHash True
37325>>>            
37325>>>            // clear the login values. we don't want to return the login id & password as synchronized properties....
37325>>>            WebSet psValue of oLoginName to ""
37326>>>            WebSet psValue of oPassword  to ""
37327>>>            WebSet pbVisible of oWarning to False
37328>>>        End
37328>>>>
37328>>>        Else Begin
37329>>>            WebSet pbVisible of oWarning to True
37330>>>        End
37330>>>>
37330>>>    End_Procedure
37331>>>    
37331>>>    Procedure OnSubmit
37334>>>        Send DoLogin
37335>>>    End_Procedure
