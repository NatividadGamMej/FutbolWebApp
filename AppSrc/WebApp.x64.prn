37336>>>    Procedure OnLoad
37339>>>        String sPrevStateHash sView
37339>>>        
37339>>>        Forward Send OnLoad
37341>>>        
37341>>>        //  Store the current state so we can go back to that later (only if it points to a different view)
37341>>>        Get StateHash of ghoWebApp to sPrevStateHash
37342>>>        Send ParseViewStateHash sPrevStateHash (&sView)
37343>>>        If (Lowercase(sView) <> Lowercase(psStateViewName(Self))) Begin
37345>>>            WebSet psPrevStateHash to sPrevStateHash
37346>>>        End
37346>>>>
37346>>>        
37346>>>    End_Procedure
