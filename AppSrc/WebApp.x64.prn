36683>>>    Procedure DoLogin
36686>>>        String sLoginName sPassword sPrevStateHash
36686>>>        Boolean bResult
36686>>>        
36686>>>        WebGet psValue of oLoginName to sLoginName
36687>>>        WebGet psValue of oPassword to sPassword
36688>>>        
36688>>>        Move True to bResult
36689>>>        
36689>>>        If (bResult) Begin
36691>>>            Send Hide of oLogin
36692>>>            Send ShowHeader of ghoWebApp
36693>>>            WebSet psCSSClass of ghoWebApp to ""
36694>>>            
36694>>>            WebGet psPrevStateHash to sPrevStateHash
36695>>>            Send NavigateToStateHash of ghoWebApp sPrevStateHash True
36696>>>            
36696>>>            // clear the login values. we don't want to return the login id & password as synchronized properties....
36696>>>            WebSet psValue of oLoginName to ""
36697>>>            WebSet psValue of oPassword  to ""
36698>>>            WebSet pbVisible of oWarning to False
36699>>>        End
36699>>>>
36699>>>        Else Begin
36700>>>            WebSet pbVisible of oWarning to True
36701>>>        End
36701>>>>
36701>>>    End_Procedure
