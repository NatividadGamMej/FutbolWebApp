37047>>>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37050>>>>>        Case Begin
37050>>>>>            Case (NavigateData.eNavigateType = nfFromMain)
37052>>>>>                // If from main, this is a propbably a main file Select to Zoom.
37052>>>>>                Case Break
37053>>>>>
37053>>>>>            Case (NavigateData.eNavigateType = nfFromParent)
37056>>>>>                // If from parent, this is a constrained drill down.
37056>>>>>                Case Break
37057>>>>>
37057>>>>>            Case (NavigateData.eNavigateType = nfFromChild)
37060>>>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37060>>>>>                Case Break
37061>>>>>
37061>>>>>            Case Else // must be nfUndefined
37061>>>>>
37061>>>>>        Case End
37061>>>>>
37061>>>>>        Send SetActionButtons
37062>>>>>
37062>>>>>    End_Procedure
37063>>>>>
37063>>>>>End_Object 
